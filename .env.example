# Copy to .env and fill in real values. Never commit .env.

# MariaDB credentials
DB_ROOT_PASSWORD=change-me
DB_NAME=ppdo_ar_db
DB_USER=root
DB_PASSWORD=change-me

# Sign-in token key: a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it signs everyone out.
JWT_SECRET=

# Optional settings
# JWT_EXPIRATION_MINUTES=120
# BUDGET_VISIBILITY=ADMINS_AND_OWN_OFFICE   (or ADMINS_ONLY, SUPERADMINS_ONLY)
# BUDGET_UNLOCK_MINUTES=10
# APP_BOOTSTRAP_PASSWORD=   (initial password for accounts created on first start)
